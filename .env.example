# Copie para .env (gitignored). Defaults locais de dev — NÃO use em prod.
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar
POSTGRES_HOST=localhost
# 5433 no host (mapeia p/ 5432 no container) — evita conflito com Postgres local na 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://radar:radar@localhost:5433/radar

# Só p/ pipeline/publish/publish_marts.py (publica os 3 marts no Neon).
# Endpoint DIRECT (sem -pooler), com sslmode=require:
# NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require
